{
  "schemaVersion": 1,
  "id": "pinkpantr.almanax",
  "name": "Almanax",
  "version": "1.1.0",
  "author": "pinkpantr",
  "description": "Dofus Almanax offering of the day, with a browsable calendar popup and a search across the year",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Almanax",
    "description": "Dofus Almanax offering of the day, with a browsable calendar popup and a search across the year",
    "category": "Games",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showOffering": true,
      "weekStartDay": 1
    },
    "schema": [
      {
        "key": "showOffering",
        "type": "boolean",
        "label": "Show the offering name in the bar"
      },
      {
        "key": "weekStartDay",
        "type": "integer",
        "label": "First day of the week",
        "min": 0,
        "max": 6,
        "step": 1,
        "defaultValue": 1,
        "description": "0 = Sunday, 1 = Monday, up to 6 = Saturday."
      }
    ]
  }
}
